// Cấu hình chạy web trên Cloudflare Workers (miễn phí). Hướng dẫn: CLOUDFLARE.md
{
  "name": "betagon-web",
  "main": "worker/index.js",
  "workers_dev": true,
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "build": { "command": "node worker/build.js" },
  "assets": { "directory": ".cf-assets", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none", "not_found_handling": "none" },
  // Cloudflare tự tạo cơ sở dữ liệu D1 và kho ảnh R2 ở lần đưa lên đầu tiên
  "d1_databases": [{ "binding": "DB", "database_name": "betagon-db" }],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "betagon-images" }],
  // mỗi phút chép một đợt ảnh từ web cũ betagon.vn (tự dừng khi xong)
  "triggers": { "crons": ["* * * * *"] },
  "vars": { "OLD_SITE_HOSTS": "betagon.vn,www.betagon.vn" },
  "observability": { "enabled": true }
}
